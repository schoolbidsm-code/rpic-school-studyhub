# RPIC SCHOOL - CLASS 10 STUDY HUB  (Developed by Divyansh Singh)
# Production me in sabko proper values ke saath set karein.

# Admin panel password
ADMIN_PASSWORD=change-this-password

# Session secret (random 32+ chars)
JWT_SECRET=change-this-random-secret

# SMS OTP provider (msg91 ya twilio). Bina iske app SMS nahi bhejta, OTP server log me print hota hai (dev only).
OTP_PROVIDER=
MSG91_AUTH_KEY=
MSG91_SENDER_ID=
MSG91_TEMPLATE_ID=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=

# Razorpay (server-side only, frontend me kabhi nahi)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Ask RPIC AI (koi bhi OpenAI-compatible API)
AI_API_KEY=
AI_BASE_URL=
AI_MODEL=

# ID card print order fee (₹)
ID_CARD_ORDER_FEE=50

PORT=3000
